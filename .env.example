# ---------------------------------------------------------------------------
# DataFlow Studio environment
#
# Everything here is optional. With no .env file at all, `pnpm dev` runs with an
# in-memory store, a local single-user identity and an embedded worker - no
# database, no Redis, no external accounts. Each variable below moves one piece
# from "development default" to "production".
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Unset: in-memory store (not durable, single process).
# Set: PostgreSQL, migrations run on first connect, workers scale horizontally.
# DATABASE_URL=postgresql://dataflow:dataflow@localhost:5432/dataflow
# Direct (non-pooled) connection, for migrations against a pooled provider.
# DIRECT_URL=postgresql://dataflow:dataflow@localhost:5432/dataflow
# Enable the optional row-level-security migration (needs a non-superuser role).
# DATAFLOW_ENABLE_RLS=false

# --- Secrets ---------------------------------------------------------------
# 32 bytes, base64 or hex: `openssl rand -base64 32`.
# Without it, only environment-injected secrets (DATAFLOW_SECRET_*) resolve.
# ENCRYPTION_KEY=
# Secrets can also be injected directly, which is what CI usually wants:
# DATAFLOW_SECRET_PROD_POSTGRES_PASSWORD=...

# --- Authentication --------------------------------------------------------
# local (default): single user, everything permitted. Never use in production.
# clerk: verify Clerk sessions; requires `pnpm add @clerk/nextjs` in apps/web.
# AUTH_MODE=local
# LOCAL_USER_ID=local-user
# LOCAL_ORGANIZATION_ID=org_local
# CLERK_SECRET_KEY=
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# --- Worker ----------------------------------------------------------------
# WORKER_CONCURRENCY=4
# Seconds a claimed task may run before another worker may reclaim it.
# TASK_LEASE_SECONDS=120
# Restrict a worker to specific node types (heterogeneous pools).
# WORKER_NODE_TYPES=sql.transform,postgres.source
# Set false to run a scheduler-free executor pool.
# WORKER_RUN_SCHEDULER=true
# Health and metrics port for the standalone worker.
# WORKER_PORT=3002
# Force the embedded worker on or off (defaults: on for memory, off for postgres).
# EMBEDDED_WORKER=

# --- Connector egress policy ----------------------------------------------
# Restrict HTTP and object-storage nodes to these hostname suffixes.
# CONNECTOR_ALLOWED_HOSTS=api.example.com,files.example.org
# CONNECTOR_BLOCKED_HOSTS=internal.example.com
# Development only: allows localhost and private ranges. Never enable in production.
# CONNECTOR_ALLOW_PRIVATE_NETWORKS=false
# CONNECTOR_MAX_RESPONSE_BYTES=10485760

# --- Python execution ------------------------------------------------------
# disabled (default): python.transform nodes fail with an explanation.
# subprocess: run locally with a scrubbed environment and resource limits.
# PYTHON_SANDBOX=disabled
# PYTHON_BIN=python3

# --- Redis (optional) ------------------------------------------------------
# Shared rate-limit counters across API instances. Without it, limits are
# per-process, which multiplies the effective limit by the instance count.
# REDIS_URL=redis://localhost:6379

# --- Durable job backend (optional) ---------------------------------------
# The execution engine runs on its own queue by default. Set this only if you
# route tasks through Trigger.dev instead.
# TRIGGER_SECRET_KEY=

# --- AI (optional) ---------------------------------------------------------
# Enables the optional debugging assistant and pipeline generator. The engine,
# scheduler and quality checks work identically without it.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# --- App -------------------------------------------------------------------
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# LOG_LEVEL=info
